<Page x:Class="WPFBankID.PersonalAccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFBankID"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="595"
      Title="Личный кабинет">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="1" Name="PrintArea">
            <StackPanel Margin="20">

                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Персональная информация:" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Name="TxtFio" Text="ФИО: " Margin="0,5"/>
                        <TextBlock Name="TxtPassport" Text="Паспорт: " Margin="0,5"/>
                        <TextBlock Name="TxtDate" Text="Дата рождения: " Margin="0,5"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Изменить данные" Click="BtnChangeData_Click" Width="130" Height="25" Style="{StaticResource ButtonOne}" Margin="0,0,10,0"/>
                            <Button Content="Поданные заявки" Click="BtnRequestsHistory_Click" Width="130" Height="25" Style="{StaticResource ButtonOne}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#F9F9F9" Padding="10" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Новый продукт:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Name="ComboNewProduct" Width="120" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0">
                            <ComboBoxItem Content="Открыть вклад"/>
                            <ComboBoxItem Content="Открыть счет"/>
                        </ComboBox>
                        <Button Content="Оставить заявку" Click="BtnOpenProduct_Click" Width="110" Height="30" Style="{StaticResource ButtonOne}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Ваши счета и вклады:" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                <ItemsControl Name="ListAccounts">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,15" Background="#FAFAFA">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" FontSize="14" Margin="0,0,0,5">
                                        <Run Text="{Binding AccountTypes.Title}"/> 
                                        <Run Text="№"/>
                                        <Run Text="{Binding Id_account}"/>
                                    </TextBlock>

                                    <TextBlock Text="{Binding Balance, StringFormat='Баланс: {0}'}" Margin="0,2"/>
                                    <TextBlock Text="{Binding Currency, StringFormat='Валюта: {0}'}" Margin="0,2"/>
                                    <TextBlock Text="{Binding Interest_rate, StringFormat='Процентная ставка: {0}%'}" Margin="0,2"/>
                                    <TextBlock Text="{Binding Date_opened, StringFormat='Открытие: {0:dd.MM.yyyy}'}" Margin="0,2"/>
                                    <TextBlock Text="{Binding Closing_date, StringFormat='Закрытие: {0:dd.MM.yyyy}'}" Margin="0,2"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Закрыть" Click="BtnCloseProduct_Click" Width="100" Height="25" Style="{StaticResource ButtonOne}" Margin="0,0,10,0"/>
                                        <Button Content="Выписка" Click="BtnExtract_Click" Width="100" Height="25" Style="{StaticResource ButtonOne}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</Page>
