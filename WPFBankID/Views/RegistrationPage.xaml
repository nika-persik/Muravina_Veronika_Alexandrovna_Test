<Page x:Class="WPFBankID.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFBankID"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Регистрация">

    <Grid Grid.Column="2" Grid.Row="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 20 0 0">
            <StackPanel Margin="0 0 20 0">
                <StackPanel HorizontalAlignment="Center" Margin="0 0 0 10">
                    <TextBlock Style="{StaticResource BlockCommon}" Text="Фамилия" FontSize="16"></TextBlock>
                    <TextBox Width="200" Name="TBoxRegSurname" Height="30" FontSize="16" Margin="0 2 0 0" VerticalAlignment="Center"></TextBox>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Margin="0 0 0 10">
                    <TextBlock Style="{StaticResource BlockCommon}" Text="Имя" FontSize="16"></TextBlock>
                    <TextBox Width="200" Name="TBoxRegName" Height="30" FontSize="16" Margin="0 2 0 0" VerticalAlignment="Center"></TextBox>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Margin="0 0 0 10">
                    <TextBlock Style="{StaticResource BlockCommon}" Text="Отчество" FontSize="16"></TextBlock>
                    <TextBox Width="200" Name="TBoxRegPatronymic" Height="30" FontSize="16" Margin="0 2 0 0" VerticalAlignment="Center"></TextBox>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Margin="0 0 0 10">
                    <TextBlock Style="{StaticResource BlockCommon}" Text="Дата рождения" FontSize="16"></TextBlock>
                    <TextBox Width="200" Name="TBoxRegDate" Height="30" FontSize="16" Margin="0 2 0 0" VerticalAlignment="Center"></TextBox>
                </StackPanel>
            </StackPanel>
            <StackPanel>
                <StackPanel HorizontalAlignment="Center" Margin="0 0 0 10">
                    <TextBlock Style="{StaticResource BlockCommon}" Text="Серия паспорта" FontSize="16"></TextBlock>
                    <TextBox Width="200" Name="TBoxRegPasSeries" Height="30" FontSize="16" Margin="0 2 0 0" VerticalAlignment="Center"></TextBox>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Margin="0 0 0 10">
                    <TextBlock Style="{StaticResource BlockCommon}" Text="Номер паспорта" FontSize="16"></TextBlock>
                    <TextBox Width="200" Name="TBoxRegPasNumber" Height="30" FontSize="16" Margin="0 2 0 0" VerticalAlignment="Center"></TextBox>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Margin="0 0 0 10">
                    <TextBlock Style="{StaticResource BlockCommon}" Text="Логин" FontSize="16"></TextBlock>
                    <TextBox Width="200" Name="TBoxRegLog" Height="30" FontSize="16" Margin="0 2 0 0" VerticalAlignment="Center"></TextBox>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Margin="0 0 0 10">
                    <TextBlock Style="{StaticResource BlockCommon}" Text="Пароль" FontSize="16"></TextBlock>
                    <TextBox Width="200" Name="TBoxRegPas" Height="30" FontSize="16" Margin="0 2 0 0" VerticalAlignment="Center"></TextBox>
                </StackPanel>
            </StackPanel>
        </StackPanel>


        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 20 0 0">
            <StackPanel Margin="0 0 0 10" Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel>
                    <Border BorderBrush="Gray" BorderThickness="1" Background="#FFF0F0F0" Width="200" Height="30" Margin="0 0 0 5" CornerRadius="3">
                        <TextBlock x:Name="CaptchaTextBlock" FontSize="16" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Name="CaptchaInputBox" Width="160" Height="25" VerticalContentAlignment="Center" Margin="0 0 5 0" FontSize="16"/>
                        <Button Name="RefreshCaptchaBtn" Width="35" Height="25" Content="↻" Click="RefreshCaptchaBtn_Click" FontSize="16"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <StackPanel>
                <Button Name="BtnReg" Click="BtnReg_Click" Content="Зарегистрироваться" Style="{StaticResource ButtonOne}" Width="200" Height="40" FontSize="16" Margin="0 10 0 0"></Button>
            </StackPanel>
        </StackPanel>

    </Grid>
</Page>
