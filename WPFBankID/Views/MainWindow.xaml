<Window x:Class="WPFBankID.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFBankID"
        mc:Ignorable="d"
        Title="MainWindow" MinHeight="700" MinWidth="595" Height="700" Width="595" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15*"></ColumnDefinition>
            <ColumnDefinition Width="80*"></ColumnDefinition>
            <ColumnDefinition Width="15*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="35*"></RowDefinition>
            <RowDefinition Height="100*"></RowDefinition>
            <RowDefinition Height="10*"></RowDefinition>
        </Grid.RowDefinitions>


        <Grid Grid.Row="0" Grid.Column="1" Background="{StaticResource ColorSecondary}"></Grid>
        <Grid Grid.Row="0" Grid.Column="0" Background="{StaticResource ColorSecondary}"></Grid>
        <Grid Grid.Row="0" Grid.Column="2" Background="{StaticResource ColorSecondary}"></Grid>
        <Grid Grid.Row="2" Grid.Column="2" Background="{StaticResource ColorSecondary}"></Grid>
        <Grid Grid.Row="2" Grid.Column="1" Background="{StaticResource ColorSecondary}"></Grid>
        <Grid Grid.Row="2" Background="{StaticResource ColorSecondary}"></Grid>
        <Grid Grid.Column="0" Grid.Row="0">
            <Image Source="/Assets/логотип_банка.png" Width="74"></Image>
        </Grid>

        <Grid Grid.Column="1" Grid.Row="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ElementName=FrameMain, Path=Content.Title}" Width="auto" Height="50" Name="MainText" Style="{StaticResource TextMain}"></TextBlock>
                </StackPanel>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="0" Grid.Column="3">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Name="BtnBack" Click="BtnBack_Click" Width="40" Background="Transparent" BorderThickness="0">
                    <Image Source="/Assets/назад.png"></Image>
                </Button>
            </StackPanel>
        </Grid>

        <Frame Name="FrameMain" NavigationUIVisibility="Hidden" Grid.Row="1" Grid.Column="1"></Frame>
    </Grid>
</Window>
